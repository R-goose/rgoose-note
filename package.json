{
  "name": "r-goose-note",
  "private": true,
  "version": "2.5.8",
  "description": "R-Goose Note - 画布式笔记应用",
  "author": "R-Goose",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:security": "node test/safe-ai-markdown.test.mjs",
    "test:client-routes": "node test/client-route-map.test.mjs",
    "test:templates": "node test/template-content.test.mjs",
    "test:import-data": "node test/import-data.test.mjs",
    "test:table-data": "node test/table-data.test.mjs",
    "test:block-layout": "node test/block-layout.test.mjs",
    "postinstall": "electron-builder install-app-deps",
    "test:smoke": "electron --no-sandbox . --test-smoke",
    "kill:app": "node scripts/kill-app.mjs",
    "clean:release": "node scripts/clean-release.mjs",
    "prepare:installer-assets": "node scripts/prepare-installer-assets.mjs",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "electron:build": "npm run prepare:installer-assets && npm run kill:app && npm run clean:release && vite build && node scripts/build-electron.mjs",
    "electron:build:mirror": "npm run prepare:installer-assets && npm run kill:app && npm run clean:release && vite build && node scripts/build-electron.mjs --mirror",
    "electron:build:win": "npm run prepare:installer-assets && npm run kill:app && npm run clean:release && vite build && node scripts/build-electron.mjs --windows-only",
    "electron:publish:gitee": "npm run electron:publish:gitee:win",
    "electron:publish:gitee:win": "npm run prepare:installer-assets && npm run kill:app && npm run clean:release && vite build && node scripts/build-electron.mjs --publish-gitee --windows-only"
  },
  "dependencies": {
    "adm-zip": "^0.5.18",
    "better-sqlite3": "11.5.0",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vueuse/core": "^14.3.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "dayjs": "^1.11.10",
    "electron": "^33.0.0",
    "electron-builder": "^24.9.1",
    "fs-extra": "^11.4.0",
    "html2canvas-pro": "^2.3.3",
    "interactjs": "^1.10.27",
    "jspdf": "^4.2.1",
    "katex": "^0.18.1",
    "pinia": "^2.1.7",
    "vite": "^5.0.0",
    "vue": "^3.4.0",
    "vue-router": "^4.2.5",
    "wait-on": "^7.2.0"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.rgoose.note",
    "productName": "R-Goose Note",
    "compression": "maximum",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*.js",
      "electron/**/*.sql",
      "electron/**/package.json",
      "build/icon.ico",
      "build/icon.icns",
      "build/icon.png",
      "build/favicon.svg",
      "node_modules/better-sqlite3/**",
      "node_modules/bindings/**",
      "node_modules/file-uri-to-path/**",
      "!test/**"
    ],
    "extraResources": [
      {
        "from": "build/app-update.yml",
        "to": "app-update.yml"
      }
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "publish": [
        {
          "provider": "generic",
          "url": "https://github.com/R-goose/rgoose-note/releases/download/latest"
        }
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity"
    },
    "dmg": {
      "background": "build/dmg-background.png",
      "icon": "build/icon.icns",
      "iconSize": 92,
      "iconTextSize": 12,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 135,
          "y": 220,
          "type": "file"
        },
        {
          "x": 405,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.ico",
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "include": "build/installer.nsh"
    },
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    }
  },
  "volta": {
    "node": "24.4.0"
  }
}
